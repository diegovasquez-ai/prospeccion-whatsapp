# Copia este archivo como .env.local y completa tus datos de Supabase
# (Supabase → Project Settings → API). Nunca subas .env.local a git.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_o_publishable_key

# Opcionales
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=57
NEXT_PUBLIC_CURRENCY=COP

# Zernio (WhatsApp Business API) — SOLO servidor: sin prefijo NEXT_PUBLIC_
ZERNIO_API_KEY=
